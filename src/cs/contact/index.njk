<section class="cs-contact cs-spotlight">
  <div class="cs-contact-grid">
    <div class="cs-contact-connect">
      <form class="contact-conversation" data-contact-chat action="https://formspree.io/f/mljgnpye" method="POST" novalidate data-required-message="Doplňte prosím jméno, e-mail a krátkou zprávu." data-email-message="Zadejte prosím platnou e-mailovou adresu." data-sending-message="Odesílám zprávu…" data-success-message="Děkuji, zpráva je na cestě. Ozvu se, jakmile budu moct." data-error-message="Něco se nepovedlo. Zkuste to prosím znovu nebo mi napište přímo.">
        <div class="contact-conversation__heading">
          <h1>Co vás sem přivádí?</h1>
          <p>Vyberte téma a napište pár vět. Detaily můžeme doladit později.</p>
        </div>
        <fieldset class="contact-conversation__choices">
          <legend>Vyberte výchozí bod.</legend>
          <label><input type="radio" name="topic" value="UX nebo produktový design" checked><span>UX nebo produktový design</span></label>
          <label><input type="radio" name="topic" value="Práce nebo spolupráce"><span>Práce nebo spolupráce</span></label>
          <label><input type="radio" name="topic" value="Jiný dotaz"><span>Jiný dotaz</span></label>
        </fieldset>
        <label class="contact-conversation__field">
          <span>Co bych měla vědět?</span>
          <textarea name="message" rows="4" placeholder="Na čem pracujete nebo kde jste se zasekli?"></textarea>
        </label>
        <div class="contact-conversation__details">
          <label class="contact-conversation__field"><span>Vaše jméno</span><input name="name" type="text" autocomplete="name"></label>
          <label class="contact-conversation__field"><span>E-mail</span><input name="email" type="email" autocomplete="email"></label>
        </div>
        <input type="hidden" name="_subject" value="Zpráva z českého portfolia">
        <div class="contact-conversation__completion">
          <p class="contact-conversation__note">Zpráva dorazí přímo do mé schránky. Jak nakládám s vašimi údaji, najdete v <a href="{{ '/cs/privacy/' | url }}">informacích o ochraně soukromí</a>.</p>
          <div class="contact-conversation__actions">
            <button class="contact-conversation__send" type="submit">Odeslat zprávu</button>
            <p class="contact-conversation__status" data-contact-status aria-live="polite"></p>
          </div>
        </div>
      </form>
    </div>
    <div class="cs-contact-ways">
      <div class="cs-contact-email-block"><span>Raději napíšete přímo?</span><a href="mailto:brittasvanda@gmail.com">brittasvanda@gmail.com</a></div>
      <nav class="cs-contact-links" aria-label="Profesní profily"><a href="https://www.linkedin.com/in/tereza-britta-%C5%A1vanda-66698b264/" target="_blank" rel="noopener">LinkedIn</a><a href="https://www.behance.net/terezabritta" target="_blank" rel="noopener">Behance</a></nav>
    </div>
  </div>
</section>
<script>(function(){var form=document.querySelector('[data-contact-chat]');if(!form)return;form.addEventListener('submit',function(event){event.preventDefault();var data=new FormData(form);var status=form.querySelector('[data-contact-status]');var name=String(data.get('name')||'').trim();var email=String(data.get('email')||'').trim();var message=String(data.get('message')||'').trim();if(!name||!email||!message){status.textContent=form.dataset.requiredMessage;return;}if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){status.textContent=form.dataset.emailMessage;return;}var button=form.querySelector('button[type="submit"]');button.disabled=true;status.textContent=form.dataset.sendingMessage;fetch(form.action,{method:'POST',body:data,headers:{Accept:'application/json'}}).then(function(response){if(!response.ok)throw new Error('Form submission failed');return response.json();}).then(function(){form.reset();form.querySelector('input[name="topic"]:checked').checked=true;status.textContent=form.dataset.successMessage;}).catch(function(){status.textContent=form.dataset.errorMessage;}).finally(function(){button.disabled=false;});});})();</script>
