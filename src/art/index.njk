      <figure class="art-gallery-card art-gallery-card--cottage" tabindex="0"><img src="{{ '/assets/art/autumn-cottage.jpg' | url }}" alt="Autumn forest with a small cottage shaped like a red mushroom" loading="lazy"><figcaption><span>Autumn Cottage</span></figcaption></figure>
