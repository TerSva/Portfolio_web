<!DOCTYPE html>
<html lang="{{ lang | default('en') }}">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>{{ title }} · Tereza Britta Švanda</title>
{% if description %}<meta name="description" content="{{ description }}"/>{% endif %}
<link rel="canonical" href="{{ siteBaseUrl }}{{ page.url | url }}"/>
{% if deUrl %}<link rel="alternate" hreflang="en" href="{{ siteBaseUrl }}{{ page.url | url }}"/>
<link rel="alternate" hreflang="de" href="{{ siteBaseUrl }}{{ deUrl | url }}"/>
<link rel="alternate" hreflang="x-default" href="{{ siteBaseUrl }}{{ page.url | url }}"/>{% endif %}
{% if enUrl %}<link rel="alternate" hreflang="de" href="{{ siteBaseUrl }}{{ page.url | url }}"/>
<link rel="alternate" hreflang="en" href="{{ siteBaseUrl }}{{ enUrl | url }}"/>
<link rel="alternate" hreflang="x-default" href="{{ siteBaseUrl }}{{ enUrl | url }}"/>{% endif %}
<meta property="og:type" content="website"/>
<meta property="og:site_name" content="Tereza Britta Švanda"/>
<meta property="og:title" content="{{ title }} — Tereza Britta Švanda"/>
{% if description %}<meta property="og:description" content="{{ description }}"/>{% endif %}
<meta property="og:url" content="{{ siteBaseUrl }}{{ page.url | url }}"/>
<meta property="og:image" content="{{ siteBaseUrl }}{{ (ogImage or '/assets/enow/hero-calm-return.png') | url }}"/>
<meta property="og:locale" content="{{ 'de_DE' if lang == 'de' else 'en_US' }}"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content="{{ title }} — Tereza Britta Švanda"/>
{% if description %}<meta name="twitter:description" content="{{ description }}"/>{% endif %}
<meta name="twitter:image" content="{{ siteBaseUrl }}{{ (ogImage or '/assets/enow/hero-calm-return.png') | url }}"/>
<style>html,body{background:#001F1C;color:#F5F5DC}.site-header{position:fixed;top:0;right:0;left:0;z-index:200;display:flex;align-items:center;justify-content:space-between;height:4.75rem;padding:0 4vw;background:#001F1C;border-bottom:1px solid #004D40}</style>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Space+Grotesk:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@300;400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="{{ '/style.css' | url }}"/>
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>

<header class="site-header">
  <span class="site-brand">Tereza Britta Švanda</span>
  <div class="nav-group">
    <nav class="site-nav" aria-label="Main navigation">
      <a href="{{ (workUrl or '/work/') | url }}"{% if activeNav == 'work' %} class="is-active" aria-current="page"{% endif %}>{{ navWork or 'Work' }}</a>
      <a href="{{ (aboutUrl or '/about/') | url }}"{% if activeNav == 'about' %} class="is-active" aria-current="page"{% endif %}>{{ navAbout or 'About' }}</a>
      <a href="{{ (cvUrl or '/cv/') | url }}"{% if activeNav == 'cv' %} class="is-active" aria-current="page"{% endif %}>CV</a>
      <a href="{{ (contactUrl or '/contact/') | url }}"{% if activeNav == 'contact' %} class="is-active" aria-current="page"{% endif %}>{{ navContact or 'Contact' }}</a>
    </nav>
    <div class="lang-switch">
      <button type="button" class="lang-current" aria-haspopup="listbox" aria-expanded="false">
        <span class="lang-current-label">{{ lang | default('en') | upper }}</span><span class="chevron" aria-hidden="true"></span>
      </button>
      <div class="lang-menu" role="listbox" hidden>
        <button type="button" role="option" data-url="{{ (enUrl or '/work/') | url }}" aria-selected="{{ 'true' if (lang | default('en')) == 'en' else 'false' }}">EN</button>
        <button type="button" role="option" data-url="{{ (deUrl or '/de/work/') | url }}" aria-selected="{{ 'true' if lang == 'de' else 'false' }}">DE</button>
      </div>
    </div>
  </div>
</header>

{% if dots %}
<nav id="cs-dots" aria-label="Section navigation">
  {% for d in dots %}
  <div class="cs-dot" data-target="{{ d.id }}" data-label="{{ d.label }}" data-zone="{{ d.zone }}"></div>
  {% endfor %}
</nav>
{% endif %}

<script>
(function(){
  var wrap = document.querySelector('.lang-switch');
  if (!wrap) return;
  var current = wrap.querySelector('.lang-current');
  var currentLabel = wrap.querySelector('.lang-current-label');
  var menu = wrap.querySelector('.lang-menu');

  function close(){ menu.hidden = true; wrap.removeAttribute('data-open'); current.setAttribute('aria-expanded','false'); }
  function open(){ menu.hidden = false; wrap.setAttribute('data-open','true'); current.setAttribute('aria-expanded','true'); }

  current.addEventListener('click', function(e){
    e.stopPropagation();
    if (menu.hidden) open(); else close();
  });
  menu.querySelectorAll('button').forEach(function(btn){
    btn.addEventListener('click', function(){
      if (window.portfolioNavigate) window.portfolioNavigate(btn.dataset.url);
      else window.location.href = btn.dataset.url;
    });
  });
  document.addEventListener('click', close);
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') close(); });
})();
</script>

<script>
/* The project indicator exists only while a precise cursor explores a visual.
   The full card remains the link; this is an affordance, not a second button. */
(function(){
  function init(){
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll('.work-project-visual').forEach(function(visual){
      visual.addEventListener('pointerenter', function(){ visual.dataset.projectCursor = 'active'; });
      visual.addEventListener('pointermove', function(event){
        var rect = visual.getBoundingClientRect();
        visual.style.setProperty('--project-cursor-x', (event.clientX - rect.left) + 'px');
        visual.style.setProperty('--project-cursor-y', (event.clientY - rect.top) + 'px');
      });
      visual.addEventListener('pointerleave', function(){ delete visual.dataset.projectCursor; });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>

<script>
/* A card's autoplaying background loop is decorative motion, not content —
   never force it on someone who has asked for less. */
(function(){
  function init(){
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll('.work-project-visual video, .cs-artifact video').forEach(function(video){
      video.removeAttribute('autoplay');
      video.pause();
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>

<main>
{{ content | safe }}
</main>

<footer class="site-footer cs-footer-dark cs-spotlight">
  <span>© 2026 Tereza Britta Švanda</span>
  <a class="footer-art-link" href="{{ '/art/' | url }}">Art portfolio</a>
  <span>Czech Republic / Germany / World</span>
</footer>

{% if dots %}
<script>
(function(){
  var dots = document.querySelectorAll('.cs-dot');
  var sections = Array.prototype.map.call(dots, function(d){
    return document.getElementById(d.dataset.target);
  });

  dots.forEach(function(dot){
    dot.addEventListener('click', function(){
      var target = document.getElementById(dot.dataset.target);
      if (target) target.scrollIntoView({behavior:'smooth', block:'start'});
    });
  });

  function docTop(el){
    return el.getBoundingClientRect().top + window.scrollY;
  }

  function onScroll(){
    var pos = window.scrollY + window.innerHeight * 0.3;
    var activeIdx = 0;
    sections.forEach(function(sec, i){
      if (sec && docTop(sec) <= pos) activeIdx = i;
    });
    dots.forEach(function(d, i){
      d.classList.toggle('active', i === activeIdx);
    });
    document.body.dataset.zone = dots[activeIdx].dataset.zone;
  }
  document.addEventListener('scroll', onScroll, {passive:true});
  onScroll();
})();
</script>
{% endif %}

<script>
/* A very small light wash belongs to deliberate top-level navigation:
   header links, and Work-index project cards (a full jump into a case
   study's own world, not a contextual link inside a paragraph). Ordinary
   content links and browser history keep their immediate behaviour. */
(function(){
  var root = document.documentElement;
  var duration = 200;
  var navigating = false;

  function reduceMotion(){
    return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function navigate(url){
    if (navigating) return;
    if (reduceMotion()) { window.location.href = url; return; }
    navigating = true;
    root.classList.add('header-navigation-leaving');
    window.setTimeout(function(){ window.location.href = url; }, duration);
  }

  document.querySelectorAll('.site-header a[href], .work-project[href]').forEach(function(link){
    link.addEventListener('click', function(event){
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (link.target && link.target !== '_self') return;
      var url = new URL(link.href, window.location.href);
      if (url.origin !== window.location.origin || url.href === window.location.href) return;
      event.preventDefault();
      navigate(url.href);
    });
  });

  window.portfolioNavigate = navigate;
})();
</script>

<script>
/* A desktop-only, CSS-rendered spotlight borrowed from the art portfolio.
   It is intentionally scoped to the dark prototype chapter and stops when
   motion is reduced or a fine hover pointer is unavailable. */
(function(){
  var zones = document.querySelectorAll('.cs-spotlight');
  var canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
  var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!zones.length || !canHover.matches || reducedMotion.matches) return;

  zones.forEach(function(zone){
    var current = {x: 50, y: 50};
    var target = {x: 50, y: 50};
    var frame = 0;

    function paint(){
      current.x += (target.x - current.x) * .18;
      current.y += (target.y - current.y) * .18;
      zone.style.setProperty('--spotlight-x', current.x + '%');
      zone.style.setProperty('--spotlight-y', current.y + '%');
      if (Math.abs(target.x - current.x) > .05 || Math.abs(target.y - current.y) > .05) {
        frame = requestAnimationFrame(paint);
      } else {
        frame = 0;
      }
    }

    zone.addEventListener('pointerenter', function(){ zone.dataset.spotlight = 'active'; });
    zone.addEventListener('pointermove', function(event){
      var rect = zone.getBoundingClientRect();
      target.x = Math.max(0, Math.min(100, ((event.clientX - rect.left) / rect.width) * 100));
      target.y = Math.max(0, Math.min(100, ((event.clientY - rect.top) / rect.height) * 100));
      if (!frame) frame = requestAnimationFrame(paint);
    });
    zone.addEventListener('pointerleave', function(){ delete zone.dataset.spotlight; });
  });
})();
</script>

<script>
/* Click-to-enlarge for dense evidence images (e.g. a competitive
   analysis panel) that are too detailed to read at column width.
   Opt in per image with .cs-lightbox-figure on its wrapping figure. */
(function(){
  var figures = document.querySelectorAll('.cs-lightbox-figure');
  if (!figures.length) return;

  var overlay = document.createElement('div');
  overlay.className = 'cs-lightbox-overlay';
  overlay.innerHTML = '<button type="button" class="cs-lightbox-close" aria-label="Close">&times;</button><img alt="">';
  document.body.appendChild(overlay);
  var overlayImg = overlay.querySelector('img');
  var closeBtn = overlay.querySelector('.cs-lightbox-close');
  var lastFocused = null;

  function open(src, alt){
    lastFocused = document.activeElement;
    overlayImg.src = src;
    overlayImg.alt = alt || '';
    overlay.dataset.open = 'true';
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
    document.addEventListener('keydown', onKeydown);
  }
  function close(){
    overlay.dataset.open = 'false';
    document.body.style.overflow = '';
    document.removeEventListener('keydown', onKeydown);
    if (lastFocused) lastFocused.focus();
  }
  function onKeydown(e){ if (e.key === 'Escape') close(); }

  figures.forEach(function(fig){
    var imgs = fig.querySelectorAll('img');
    if (!imgs.length) return;
    imgs.forEach(function(img){
      img.setAttribute('tabindex', '0');
      img.setAttribute('role', 'button');
      if (!img.hasAttribute('aria-label')) img.setAttribute('aria-label', 'Expand image');
      img.addEventListener('click', function(e){ e.stopPropagation(); open(img.src, img.alt); });
      img.addEventListener('keydown', function(e){
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(img.src, img.alt); }
      });
    });
  });
  overlay.addEventListener('click', function(e){
    if (e.target === overlay || e.target === overlayImg) close();
  });
  closeBtn.addEventListener('click', close);
})();
</script>

</body>
</html>
